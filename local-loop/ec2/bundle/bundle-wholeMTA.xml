<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer" />
    <bean id="bundle" class="org.onebusaway.transit_data_federation.services.FederatedTransitDataBundle">
      <property name="path" value="${bundlePath}" />
    </bean>
    <bean id="nycBundle" class="org.onebusaway.nyc.transit_data_federation.bundle.model.NycFederatedTransitDataBundle">
      <property name="path" value="${bundlePath}" />
    </bean>

    <!-- Whole-MTA C6 pick: 5 NYCT surface boroughs (agency MTA NYCT) + MTA Bus Company (MTABC, incl. express) -->
    <bean id="gtfs-bundles" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundles">
        <property name="bundles">
            <list>
                <ref bean="gtfs_m" /><ref bean="gtfs_bx" /><ref bean="gtfs_b" /><ref bean="gtfs_q" /><ref bean="gtfs_s" /><ref bean="gtfs_mtabc" />
            </list>
        </property>
    </bean>
    <bean id="gtfs_m" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundle">
        <property name="defaultAgencyId" value="MTA NYCT" />
        <property name="path" value="/data/bundle-src/wholeMTA/GTFS_SURFACE_M_C6_REG_06282026_06052026.zip" />
    </bean>
    <bean id="gtfs_bx" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundle">
        <property name="defaultAgencyId" value="MTA NYCT" />
        <property name="path" value="/data/bundle-src/wholeMTA/GTFS_SURFACE_BX_C6_REG_06282026_06052026.zip" />
    </bean>
    <bean id="gtfs_b" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundle">
        <property name="defaultAgencyId" value="MTA NYCT" />
        <property name="path" value="/data/bundle-src/wholeMTA/GTFS_SURFACE_B_C6_REG_06282026_06052026.zip" />
    </bean>
    <bean id="gtfs_q" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundle">
        <property name="defaultAgencyId" value="MTA NYCT" />
        <property name="path" value="/data/bundle-src/wholeMTA/GTFS_SURFACE_Q_C6_REG_06282026_06052026.zip" />
    </bean>
    <bean id="gtfs_s" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundle">
        <property name="defaultAgencyId" value="MTA NYCT" />
        <property name="path" value="/data/bundle-src/wholeMTA/GTFS_SURFACE_S_C6_REG_06282026_06052026.zip" />
    </bean>
    <bean id="gtfs_mtabc" class="org.onebusaway.transit_data_federation.bundle.model.GtfsBundle">
        <property name="defaultAgencyId" value="MTABC" />
        <property name="path" value="/data/bundle-src/wholeMTA/GTFS_MTABC_C6_REG_06282026.zip" />
    </bean>

    <!-- basePath must be set: without it MultiCSVLogger writes the build's diagnostic CSVs (unmatched
         trips, duplicate runs, null sign codes) to java.io.tmpdir, where they are easily lost. Under
         the bundle output they stay alongside the bundle they describe. -->
    <bean id="multiCSVLogger" class="org.onebusaway.nyc.transit_data_federation.bundle.tasks.MultiCSVLogger">
        <property name="basePath" value="${bundlePath}/csv" />
    </bean>
    <bean id="clearCSVsTask" class="org.onebusaway.nyc.transit_data_federation.bundle.tasks.ClearCSVTask">
        <property name="logger" ref="multiCSVLogger"/>
    </bean>
    <bean class="org.onebusaway.transit_data_federation.bundle.model.TaskDefinition">
        <property name="taskName" value="clearCSVsTask" /><property name="afterTaskName" value="gtfs" /><property name="beforeTaskName" value="transit_graph" /><property name="task" ref="clearCSVsTask" />
    </bean>
    <bean id="checkShapesTask" class="org.onebusaway.nyc.transit_data_federation.bundle.tasks.CheckShapeIdTask">
        <property name="logger" ref="multiCSVLogger"/>
    </bean>
    <bean class="org.onebusaway.transit_data_federation.bundle.model.TaskDefinition">
        <property name="taskName" value="checkShapesTask" /><property name="afterTaskName" value="clearCSVsTask" /><property name="beforeTaskName" value="transit_graph" /><property name="task" ref="checkShapesTask" />
    </bean>
    <bean id="stifLoaderTask" class="org.onebusaway.nyc.transit_data_federation.bundle.tasks.stif.stifImport.StifImportTask">
        <property name="logger" ref="multiCSVLogger"/>
        <property name="stifPath" value="/data/bundle-src/wholeMTA/stif-c6-all" />
        <!-- Do not set excludeNonRevenue=false to recover trips dropped during STIF matching. It
             re-keys every trip, recovering those with a non-revenue stop at the start while breaking
             the larger set carrying one at the end. Neither setting is correct; the inconsistent match
             key is handled in StifTripLoaderSupport instead. -->
        <property name="notInServiceDscPath" value="/data/bundle-src/wholeMTA/NotInServiceDSCs.txt" />
    </bean>
    <bean class="org.onebusaway.transit_data_federation.bundle.model.TaskDefinition">
        <property name="taskName" value="stifLoaderTask" /><property name="afterTaskName" value="checkShapesTask" /><property name="beforeTaskName" value="transit_graph" /><property name="task" ref="stifLoaderTask" />
    </bean>
    <bean id="summarizeCSVTask" class="org.onebusaway.nyc.transit_data_federation.bundle.tasks.SummarizeCSVTask">
        <property name="logger" ref="multiCSVLogger"/>
    </bean>
    <bean class="org.onebusaway.transit_data_federation.bundle.model.TaskDefinition">
        <property name="taskName" value="summarizeCSVTask" /><property name="afterTaskName" value="stifLoaderTask" /><property name="beforeTaskName" value="transit_graph" /><property name="task" ref="summarizeCSVTask" />
    </bean>
</beans>
