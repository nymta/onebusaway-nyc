[Unit]
Description=OBA-NYC GTFS-RT producer (gtfsrt-webapp :8083)
After=network-online.target oba-broker.service oba-predictions.service
Wants=network-online.target
Requires=oba-broker.service
[Service]
User=oba
ExecStart=/opt/oba/run-gtfsrt.sh
Restart=always
RestartSec=15
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
