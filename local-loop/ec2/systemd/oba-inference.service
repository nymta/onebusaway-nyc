[Unit]
Description=OBA-NYC inference (vehicle-tracking-webapp :8081, RabbitMQ ingest)
After=network-online.target oba-broker.service
Wants=network-online.target
Requires=oba-broker.service
[Service]
User=oba
ExecStart=/opt/oba/run-inference.sh
Restart=always
RestartSec=15
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
