{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListInferenceArchivePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::mtalirr",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "oba-ec2-inference",
            "oba-ec2-inference/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteInferenceArchiveObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::mtalirr/oba-ec2-inference/*"
    }
  ]
}
