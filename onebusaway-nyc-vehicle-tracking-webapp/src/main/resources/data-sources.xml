<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- Bundle Manager Configuration -->
    <bean class="org.onebusaway.container.spring.SystemPropertyOverrideConfigurer">
        <property name="order" value="-2" />
        <property name="properties">
            <props>
                <!-- Set this to a path where you want to store your bundles. -->
                <prop key="bundle.location">${bundle.location}</prop>
                <!-- true = DO NOT automatically download bundles from the TDM -->
                <prop key="bundle.mode.standalone">${bundle.mode.standalone}</prop>
                <prop key="tdm.port">${tdm.port}</prop>
                <prop key="tdm.url">${tdm.url}</prop>
            </props>
        </property>
    </bean>

    <!-- Bundle Database Configuration; always HSQLDB -->
    <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="${db.driverClassName}" />
        <property name="url" value="${db.url}" />
        <property name="username" value="${db.username}" />
        <property name="password" value="${db.password}" />
    </bean>
    
    <alias name="dataSource" alias="mutableDataSource" />

    <!-- define which TDM to use -->
    <bean id="transitDataManagerApiLibrary" class="org.onebusaway.nyc.util.impl.tdm.TransitDataManagerApiLibrary" >
      <constructor-arg type="java.lang.String" value="${tdm.host}"/>
      <constructor-arg type="java.lang.Integer" value="${tdm.port}" />
      <constructor-arg type="java.lang.String" value="${tdm.url}" />
    </bean>
    
    <bean id="pullOutApiLibrary" class="org.onebusaway.nyc.util.impl.vtw.PullOutApiLibrary" >
      <constructor-arg type="java.lang.String" value="${pipo.host}"/>
      <constructor-arg type="java.lang.Integer" value="443" />
      <constructor-arg type="java.lang.String" value="/yardtrek-cron/" />
      <constructor-arg type="java.lang.Boolean" value="true" />
    </bean>
    
    <bean id="vehiclePulloutService" class="org.onebusaway.nyc.transit_data_federation.impl.vtw.${vehicle.pipo.service}" />

    <!--  Cancelled Trip Configuration -->
    <bean id="cancelledTripService" class="org.onebusaway.nyc.transit_data_federation.impl.queue.CancelledTripHttpListenerTask">
    </bean>

    <bean id="unassignedVehicleService" class="org.onebusaway.nyc.vehicle_tracking.impl.unassigned.${unassigned.vehicle.service}" />

    <!-- Input Queue Configuration -->
	<!-- This option listens to the queue with pilot and SI data on it. -->
	
   	<bean id="bhsInputQueue" class="org.onebusaway.nyc.vehicle_tracking.impl.queue.${ie.listener}" depends-on="ieInQHost,ieInQPort,ieInQName,ieAcceptAll,ieRmqAddr,ieRmqUser,ieRmqPass,ieRmqStream,ieRmqVhost,ieRmqSsl,ieRmqOffset,ieRmqPrefetch"> 
 		<property name="depotPartitionKey" value="${depot.partition.key}"/>
   	</bean>

	<!-- local broker-less LIVE FEED: seed the raw-GPS input-queue endpoint so the REAL
	     PartitionedInputQueueListenerTask SUB-connects to the local-loop/mq bridge at
	     localhost:5563 / topic "bustech", and relax depot-partition filtering (no TDM) so every
	     well-formed envelope is accepted. Active only with -P local-ie-testing,local-live-feed
	     (the dummy listener ignores these; the HTTP /update-vehicle-location.do path is unaffected). -->
	<bean id="ieInQHost" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.inputQueueHost</value><value>localhost</value></list></property>
	</bean>
	<bean id="ieInQPort" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.inputQueuePort</value><value>5563</value></list></property>
	</bean>
	<bean id="ieInQName" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.inputQueueName</value><value>bustech</value></list></property>
	</bean>
	<bean id="ieAcceptAll" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.acceptAllVehicles</value><value>true</value></list></property>
	</bean>

	<!-- production RabbitMQ ingestion (in-process RabbitMqInputQueueListenerTask): seed inference-engine.rabbitmq.*
	     from -Doba.rmq.* system properties, which the systemd unit populates from SSM Parameter Store at launch.
	     Selected by -Die.listener=RabbitMqInputQueueListenerTask (the ${ie.listener} above). -->
	<bean id="ieRmqAddr" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.addresses</value><value>${oba.rmq.addresses}</value></list></property>
	</bean>
	<bean id="ieRmqUser" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.username</value><value>${oba.rmq.username}</value></list></property>
	</bean>
	<bean id="ieRmqPass" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.password</value><value>${oba.rmq.password}</value></list></property>
	</bean>
	<bean id="ieRmqStream" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.streamName</value><value>${oba.rmq.streamName}</value></list></property>
	</bean>
	<bean id="ieRmqVhost" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.virtualHost</value><value>${oba.rmq.virtualHost}</value></list></property>
	</bean>
	<bean id="ieRmqSsl" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.ssl</value><value>${oba.rmq.ssl}</value></list></property>
	</bean>
	<bean id="ieRmqOffset" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.offset</value><value>${oba.rmq.offset}</value></list></property>
	</bean>
	<bean id="ieRmqPrefetch" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.rabbitmq.prefetch</value><value>${oba.rmq.prefetch}</value></list></property>
	</bean>

	<!--  for debugging purposes, the TDS can be populated via a JSON file -->
	<!-- 
   	<bean id="fileInput" class="org.onebusaway.nyc.vehicle_tracking.impl.queue.FileInputTask" >
  		<property name="filename" value="${user.home}/src/dump_raw.sql" />
  	</bean>
    -->
	<!-- Output Queue Configuration -->
	<!-- This option sends inference output to a TDM configured queue for pickup by an external TDF/TDS -->
	<!-- This option sends inference output to a local running TDF/TDS -->
  	<!-- local broker-less: seed the output-queue endpoint into ConfigurationService (no TDM) so
	     OutputQueueSenderServiceImpl connects to the predictions engine on localhost:5566 / inference_queue -->
	<bean id="ieOutQHost" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.outputQueueHost</value><value>localhost</value></list></property>
	</bean>
	<bean id="ieOutQPort" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.outputQueuePort</value><value>5566</value></list></property>
	</bean>
	<bean id="ieOutQName" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>inference-engine.outputQueueName</value><value>inference_queue</value></list></property>
	</bean>
  	<bean id="inferenceOutputQueue" class="org.onebusaway.nyc.vehicle_tracking.impl.queue.${ie.output.queue}" depends-on="ieOutQHost,ieOutQPort,ieOutQName">
  		<property name="isPrimaryInferenceInstance" value="true"/>
        <property name="primaryHostname" value=""/>
	</bean>

	<!--  Time Queue Configuration -->
	<!--  This option integrates with an external time prediction queue -->
	<!-- local broker-less (loop-back): seed the time-prediction queue endpoint so this consumer CONNECTs
	     to the predictions engine at localhost:5568 topic "time" and feeds predictions back into the TDS.
	     NOTE the port key is tds.timePredictionQueueOutputPort (default 5569); we use 5568. Also requires
	     -DtimePredictions.status=ENABLED. countInterval=1 makes each consumed message log (proof of receipt). -->
	<bean id="tdsTimeQHost" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>tds.timePredictionQueueHost</value><value>localhost</value></list></property>
	</bean>
	<bean id="tdsTimeQPort" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>tds.timePredictionQueueOutputPort</value><value>5568</value></list></property>
	</bean>
	<bean id="tdsTimeQName" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>tds.timePredictionQueueName</value><value>time</value></list></property>
	</bean>
	<bean id="tdsUseTimePredictions" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetObject" ref="configurationService"/>
		<property name="targetMethod" value="updateConfigurationMap"/>
		<property name="arguments"><list><value>display.useTimePredictions</value><value>true</value></list></property>
	</bean>
	<bean id="timeInputQueue" class="org.onebusaway.nyc.transit_data_federation.impl.predictions.QueuePredictionIntegrationServiceImpl" depends-on="tdsTimeQHost,tdsTimeQPort,tdsTimeQName,tdsUseTimePredictions">
		<property name="countInterval" value="1"/>
		<property name="status" value="${timePredictions.status}"/>
	</bean>
	
	<!-- 
	<bean id="predictionService" class="org.onebusaway.nyc.transit_data_federation.impl.predictions.StopBasedPredictionIntegrationService">
	  <property name="predictionGenerationService" ref="timeInputQueue"/>
	</bean>
	 -->
	<!-- Other Stuff: -->
    <bean class="org.onebusaway.container.spring.PropertyOverrideConfigurer">
        <property name="properties">
            <props>
				<!-- This turns off OBA's feature to log vehicle updates into the DB. -->
                <prop key="blockLocationServiceImpl.persistBlockLocationRecords">false</prop>
                
				<!-- This turns off OBA's feature to propagate vehicle positions based on schedule between updates -->
                <prop key="blockLocationServiceImpl.locationInterpolation">false</prop>

                <prop key="cacheManager.cacheManagerName">org.onebusaway.transit_data_federation_webapp.cacheManager</prop>
                <prop key="ehCacheConfiguration.configLocation">classpath:org/onebusaway/nyc/vehicle_tracking/webapp/ehcache.xml</prop>
                
            </props>
        </property>
    </bean>
    
    <bean class="org.onebusaway.nyc.vehicle_tracking.impl.particlefilter.ParticleFilter" scope="prototype">
        <property name="_debugEnabled" value="${particle.filter.debug}"/>
    </bean>

    <bean id="bundleManagementService" class="org.onebusaway.nyc.transit_data_federation.impl.bundle.BundleManagementServiceImpl">
        <property name="bundleStoreRoot" value="${bundle.location}" />
        <property name="standaloneMode" value="${bundle.mode.standalone}" />
    </bean>

    <bean id="scheduledExecutorService" class="org.springframework.scheduling.concurrent.ScheduledExecutorFactoryBean" />
    <bean id="taskScheduler" class="org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler" />

    <context:component-scan base-package="org.onebusaway.transit_data_federation.bundle.tasks.transit_graph"/>

    <import resource="${siri.service.config}"/>
        
</beans>
